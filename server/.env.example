# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Postgres connection string. Local dev default matches docker-compose.yml.
DATABASE_URL="postgresql://women360:women360@localhost:5432/women360?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS="http://localhost:5173"

# Set to a real address once one exists; used only in transactional-email
# copy templates, never fabricated.
SUPPORT_EMAIL="admin.women360@gmail.com"

# Optional. Two-factor sign-in is only offered when this is set. A base64
# 32-byte key that encrypts each person's authenticator secret at rest:
#   openssl rand -base64 32
# Keep it out of the database and out of git — anyone with both the key and a
# database dump could read the secrets. Losing it means everyone with two-factor
# on must have it reset, so back it up wherever you keep production secrets.
# TWO_FACTOR_ENCRYPTION_KEY=""

# Outgoing email (password reset, and alerts to the support address). Render's free tier blocks
# SMTP, so use an email API over HTTPS: a Brevo account with the sender (SUPPORT_EMAIL) verified, and
# its API key. SMTP_URL still works on hosts that allow SMTP. Without either, development prints each
# message to the console and production sends nothing and logs a warning, so a forgotten password
# cannot be recovered. Check it end to end with:  npm run mail:check -- you@example.com
#   BREVO_API_KEY=""
#   SMTP_URL="smtps://username:password@smtp.example.com:465"
#   MAIL_FROM="Women360 <admin.women360@gmail.com>"   # defaults to Women360 <SUPPORT_EMAIL>
# Where the web app lives, for links inside emails (defaults to the first CORS origin).
#   APP_URL="https://women-360.vercel.app"

# Reminders that reach her when the app is closed (web push). Make a pair once with
#   npm run push:keys
# and set both on the server. Keep the private key secret and never change it casually: devices
# subscribed under the old key stop receiving reminders until they turn them on again.
# Without them the feature is off and the app says reminders only appear while it is open.
#   VAPID_PUBLIC_KEY=""
#   VAPID_PRIVATE_KEY=""

# Lets the nightly backup job report "a backup was restored and checked" so the administrator's Service status shows
# when. 32+ characters; the same value as the BACKUP_REPORT_TOKEN GitHub secret. Unset = no reporting.
#   BACKUP_REPORT_TOKEN=""

# Features waiting for a clinician's review (screening schedule, "worth discussing" patterns, condition
# guidance, activity plans, Learn). Anything but the exact word "true" keeps them off, which is right for
# a public launch until a clinician has signed off.
#   CLINICAL_CONTENT="false"

# Request limits per address (defaults shown). Only the browser tests raise these.
#   API_RATE_LIMIT_PER_MINUTE=120
#   AUTH_RATE_LIMIT_PER_15_MIN=20

# Optional. Comma-separated IP addresses allowed to reach /api/v1/admin; anyone
# else gets a 404. Leave unset to allow any IP (admins still need two-factor in
# production).
# ADMIN_IP_ALLOWLIST=""

# Optional. Set to "true" on a hosted deployment to create the three shared
# demonstration logins (woman, coach, read-only administrator) when the service
# is built; see server/prisma/seedDemo.ts. Their passwords are published, so only
# switch this on where that is acceptable. Local databases always seed them.
# SEED_DEMO_ACCOUNTS="true"

# Features that make health claims needing a clinician's review (screening schedule, "worth
# discussing with a doctor" patterns, condition guidance, activity plans, "explain this" cards,
# Learn articles). Off unless this is exactly "true". Leave it off until a clinician has reviewed
# server/src/modules/{screening,conditions,activity/plan}/guidelines.ts and the Learn content.
# CLINICAL_CONTENT="false"
