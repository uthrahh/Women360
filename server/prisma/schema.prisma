// Women360 — data model.
//
// Scope note: this models the entities the SRS (Documentation/SRS.pdf §6.1)
// and the existing frontend (src/types/index.ts) actually use today. Per
// SRS §15 ("Assumptions"), the first implementation may use a focused
// subset of the full health-domain model while keeping an architecture
// that can accommodate additional modules — new domains are added as new
// models + a new module under src/modules, following the same pattern.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum Role {
  WOMAN
  COACH
  ADMIN
}

enum LifeStage {
  REPRODUCTIVE
  PERIMENOPAUSE
  MENOPAUSE
  POSTMENOPAUSE
}

enum ContraceptionMethod {
  NONE
  PILL
  IUD_COPPER
  IUD_HORMONAL
  IMPLANT
  INJECTION
  CONDOM
  NATURAL_METHODS
  STERILISATION
  OTHER
}

enum PregnancyStatus {
  NOT_PREGNANT
  TRYING_TO_CONCEIVE
  PREGNANT
  POSTPARTUM
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  dateOfBirth    DateTime? @db.Date
  role           Role      @default(WOMAN)
  lifeStage      LifeStage?
  avatarInitials String?
  onboarded      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  // Any access token issued before this instant is rejected, so changing a
  // password or "sign out everywhere" takes effect immediately instead of
  // after the 15-minute access-token lifetime.
  sessionsValidAfter DateTime?
  // Two-factor sign-in (TOTP). The secret is AES-256-GCM encrypted (never
  // plaintext); twoFactorLastStep is the last accepted 30-second time step,
  // so a code can't be used twice.
  twoFactorEnabled   Boolean   @default(false)
  twoFactorSecretEnc String?
  twoFactorLastStep  Int?
  // A shared demonstration account (see prisma/seedDemo.ts) whose credentials are
  // published for evaluators. It can look around but cannot change shared
  // settings, delete itself or change its own password, and a demo administrator
  // only ever sees other demo accounts.
  isDemo             Boolean   @default(false)

  twoFactorBackupCodes TwoFactorBackupCode[]
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  healthProfile        HealthProfile?
  emergencyContact     EmergencyContact?
  seniorEssentials     SeniorEssentialPreference[]
  nutritionGoal        NutritionGoal?
  activityGoal         ActivityGoal?
  cycleProfile         CycleProfile?

  cycleEntries      CycleEntry[]
  mealEntries       MealEntry[]
  hydrationLogs     HydrationLog[]
  fruitVegLogs      FruitVegLog[]
  activityEntries   ActivityEntry[]
  stepsLogs         StepsLog[]
  activityQuickLogs ActivityQuickLog[]
  activityPlans     ActivityPlan[]
  conditions        UserCondition[]
  signalStates      HealthSignalState[]
  reproductiveHealth ReproductiveHealth?
  activityQuickLogSeeded Boolean @default(false)
  sleepEntries      SleepEntry[]
  wellbeingEntries  WellbeingEntry[]
  goals             Goal[]
  habits            Habit[]
  screeningRecords  ScreeningRecord[]
  feedback          Feedback[]
  appointments      Appointment[]
  medications       Medication[]
  medicationLogs    MedicationLog[]
  vitals            VitalMeasurement[]
  reports           Report[]
  notifications     Notification[]
  receivedMessages  Message[]                @relation("MessageRecipient")

  coachAssignmentsAsWoman CoachAssignment[] @relation("WomanAssignments")
  coachAssignmentsAsCoach CoachAssignment[] @relation("CoachAssignments")
  coachNotesAuthored      CoachNote[]       @relation("CoachNoteAuthor")
  coachNotesAboutMe       CoachNote[]       @relation("CoachNoteSubject")

  auditLogs AuditLog[]

  @@index([role])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Single-use recovery codes for someone who's lost their authenticator. Only
// a SHA-256 of each code is stored; they're 50 random bits each, shown once.
model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Sign-in attempt counters, kept in the database (not memory) so they survive
// the API restarting or sleeping. `key` is "acct:<sha256 of email>" or
// "ip:<address>"; no plaintext email is stored.
model AuthThrottle {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Health profile & preferences (Settings)
// ---------------------------------------------------------------------------

// What she chooses to record about contraception and pregnancy. Informational
// only: nothing here is used to predict fertility or to advise on either.
model ReproductiveHealth {
  id              String                @id @default(cuid())
  userId          String                @unique
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contraception   ContraceptionMethod?
  pregnancyStatus PregnancyStatus?
  expectedDueDate DateTime?             @db.Date
  notes           String?
  updatedAt       DateTime              @updatedAt
}

model HealthProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergies     String[] @default([])
  // Medicine categories or names the person listed at sign-up. Not a medication
  // schedule: doses and reminders live in Medication.
  currentMedications String[] @default([])
  conditions    String[] @default([])
  familyHistory String?
  notes         String?
  updatedAt     DateTime @updatedAt
}

model EmergencyContact {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  relationship String?
  updatedAt    DateTime @updatedAt
}

enum SeniorEssentialKey {
  HEALTH
  MEDICINES
  APPOINTMENTS
  ACTIVITY
  SLEEP
  NUTRITION
  MESSAGES
  CYCLE
  EMERGENCY
}

model SeniorEssentialPreference {
  id      String             @id @default(cuid())
  userId  String
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  key     SeniorEssentialKey
  enabled Boolean            @default(true)

  @@unique([userId, key])
}

// ---------------------------------------------------------------------------
// Menstrual & reproductive health
// ---------------------------------------------------------------------------

enum FlowLevel {
  SPOTTING
  LIGHT
  MEDIUM
  HEAVY
}

model CycleProfile {
  id                  String @id @default(cuid())
  userId              String @unique
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  averageCycleLength  Int    @default(28)
  averagePeriodLength Int    @default(5)
  // Opt-in: also show the cycle card on the home screen while she is in the ovulation phase
  // (by default it only shows while she is menstruating).
  showOvulationOnHome Boolean @default(false)
}

model CycleEntry {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime   @db.Date
  isPeriod  Boolean    @default(false)
  flow      FlowLevel?
  pain      Int?
  energy    Int?
  mood      String?
  symptoms  String[]   @default([])
  notes     String?
  // Why the cycle this period ended was unusual (stress, illness, travel,
  // a medication or birth-control change...) — set on the period's start
  // day. Lets the person tell the app what happened instead of it silently
  // treating an outlier as her normal. Controlled vocabulary, validated in
  // cycle.validation.ts.
  contextTags String[] @default([])
  // When true, the cycle that this period's start day ended is left out of
  // cycle-length prediction (it's still shown in history).
  excludeCycle Boolean @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ---------------------------------------------------------------------------
// Nutrition
// ---------------------------------------------------------------------------

model NutritionGoal {
  id             String @id @default(cuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hydrationGoalMl Int   @default(2200)
  proteinGoalG    Float @default(70)
  fibreGoalG      Float @default(28)
  fruitVegGoal    Int   @default(5)
}

model MealEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  time      String
  name      String
  calories  Float
  proteinG  Float
  fibreG    Float
  servings  String
  carbsG    Float?
  fatG      Float?
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model HydrationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  amountMl  Int
  loggedAt  DateTime @default(now())

  @@index([userId, date])
}

// A single quick-log tap = one serving, mirroring HydrationLog's shape —
// replaces what used to be a hardcoded-zero "not modeled yet" field.
model FruitVegLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  servings  Int      @default(1)
  loggedAt  DateTime @default(now())

  @@index([userId, date])
}

// ---------------------------------------------------------------------------
// Activity & sleep
// ---------------------------------------------------------------------------

enum Intensity {
  LOW
  MODERATE
  HIGH
}

model ActivityGoal {
  id                  String @id @default(cuid())
  userId              String @unique
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepsGoal           Int    @default(8000)
  activeMinutesGoal   Int    @default(45)
}

model ActivityEntry {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  // Which activity from the catalog (modules/activity/catalog.ts); "other" for entries
  // logged before there was a catalog. `type` keeps the readable name.
  activityCode    String    @default("other")
  durationMinutes Int
  intensity       Intensity
  distanceKm      Float?
  sets            Int?
  notes           String?
  date            DateTime  @db.Date
  createdAt       DateTime  @default(now())

  @@index([userId, date])
}

// Conditions she has told us she has (never inferred). They tailor what the app suggests tracking
// and bringing to her doctor; they are her own record, not a diagnosis the app made.
enum HealthCondition {
  PCOS
  ENDOMETRIOSIS
  THYROID
  PMDD
  PERIMENOPAUSE
  ANAEMIA
}

model UserCondition {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  condition HealthCondition
  createdAt DateTime        @default(now())

  @@unique([userId, condition])
}

// Where each "worth discussing with a doctor" pattern stands for her: when it first appeared,
// whether she was told (one in-app notification, once), and whether she set it aside.
model HealthSignalState {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  firstSeenAt DateTime  @default(now())
  notifiedAt  DateTime?
  dismissedAt DateTime?

  @@unique([userId, key])
}

enum PlanGoal {
  HEALTH
  STRENGTH
  STAMINA
  BALANCE
  STRESS
}

enum PlanStatus {
  ACTIVE
  ENDED
}

// A personalised activity plan she asked for. `plan` is the plan exactly as it was built
// (modules/activity/plan/planner.ts) and is never rebuilt behind her back; her progress
// against it is worked out from her logged activity when she looks. Ending a plan keeps
// the row, so it stays in her data export.
model ActivityPlan {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal           PlanGoal
  weeks          Int
  startDate      DateTime   @db.Date
  // ISO weekdays she said she can be active (1 = Monday ... 7 = Sunday).
  days           Int[]
  sessionMinutes Int
  activityCodes  String[]   @default([])
  status         PlanStatus @default(ACTIVE)
  plan           Json
  createdAt      DateTime   @default(now())
  endedAt        DateTime?

  @@index([userId, status])
}

// One of her one-tap activity shortcuts ("15-min walk"). She adds and removes
// these herself; the defaults are copied in once, the first time she opens them
// (User.activityQuickLogSeeded), so removing every one stays removed.
model ActivityQuickLog {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label           String
  type            String
  activityCode    String    @default("other")
  durationMinutes Int
  intensity       Intensity
  createdAt       DateTime  @default(now())

  // The same activity, length and effort can only be a shortcut once.
  @@unique([userId, activityCode, durationMinutes, intensity])
  @@index([userId])
}

model StepsLog {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  steps  Int

  @@unique([userId, date])
}

model SleepEntry {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The morning she woke (the key for the night). bedDate is the day she went to bed; null on
  // entries logged before it was asked, whose bed day is worked out from the two times.
  date           DateTime @db.Date
  bedDate        DateTime? @db.Date
  durationHours  Float
  quality        Int
  bedtime        String
  wakeTime       String
  notes          String?
  createdAt      DateTime @default(now())

  @@unique([userId, date])
}

// ---------------------------------------------------------------------------
// Wellbeing & goals
// ---------------------------------------------------------------------------

model WellbeingEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  mood      Int
  stress    Int
  energy    Int
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

enum GoalCategory {
  SLEEP
  ACTIVITY
  HYDRATION
  NUTRITION
  STRENGTH
  CYCLE
  MOBILITY
  BODY
  LEARNING
  PREVENTIVE
  OTHER
}

// What kind of finish line a goal has. TOTAL builds up to a number (read 12
// books), REACH moves a number from where it is to a target (weight 72 -> 67),
// ONE_OFF is a single thing to do (book a check-up). Daily or weekly routines
// are Habits, not Goals.
enum GoalKind {
  TOTAL
  REACH
  ONE_OFF
}

model Goal {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  category     GoalCategory
  currentValue Float        @default(0)
  targetValue  Float        @default(100)
  unit         String       @default("")
  reminder     String?
  completed    Boolean      @default(false)
  kind         GoalKind     @default(TOTAL)
  // Where a REACH goal started, so progress is measured from there.
  startValue   Float?
  dueDate      DateTime?    @db.Date
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  // Superseded by Habit/HabitLog; no code reads or writes this any more. The
  // table is kept (not dropped) until the owner confirms nothing needs it.
  checkIns     GoalCheckIn[]
}

// A routine done every day, or some days a week: walk 10,000 steps, take a
// vitamin, stretch. A habit with a target records an amount each day and counts
// as done when the amount reaches it; one without is simply ticked off.
model Habit {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  target      Float?
  unit        String?
  daysPerWeek Int        @default(7)
  reminder    String?
  // Set when the habit is a physical activity (a catalog code, or "any"), so the
  // Activity page can list it as today's to-do.
  activityCode String?
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  logs        HabitLog[]

  @@index([userId])
}

// When she last had a preventive screening (blood pressure, cervical, ...). The
// screening ids and their intervals live in code (modules/screening/guidelines.ts);
// this only records what she did. History is kept; the latest row decides what's next.
model ScreeningRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  screeningId String
  doneOn      DateTime @db.Date
  createdAt   DateTime @default(now())

  @@index([userId, screeningId])
}

// One row = this habit was logged on this day, on the person's own calendar day.
model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  amount    Float?
  createdAt DateTime @default(now())

  @@unique([habitId, date])
}

// One row = "I did this today" for a goal, on the person's own calendar day
// (the client sends the date, so a late-night check-in lands on the right day
// regardless of server timezone). The streak is derived from these rows, never
// stored, so it can't drift from the data behind it.
model GoalCheckIn {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([goalId, date])
}

// In-app feedback from Settings. Deleted with the account.
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  message   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Preventive care
// ---------------------------------------------------------------------------

enum AppointmentKind {
  CHECKUP
  SCREENING
  VACCINATION
  COACH
}

model Appointment {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  provider  String
  date      DateTime
  time      String
  location  String
  kind      AppointmentKind
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, date])
}

model Medication {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  dose      String
  schedule  String
  // Structured dose times (e.g. ["08:00", "20:00"]), used to generate
  // today's expected doses for adherence tracking — `schedule` stays the
  // free-text human label ("Twice daily") shown alongside it.
  times     String[] @default([])
  remaining Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs MedicationLog[]
}

enum MedicationLogStatus {
  TAKEN
  SKIPPED
}

// One row per actually-recorded dose (taken or skipped) — a dose the user
// hasn't acted on yet has no row at all, and is derived as PENDING/OVERDUE
// from Medication.times at read time, not stored.
model MedicationLog {
  id           String              @id @default(cuid())
  medicationId String
  medication   Medication          @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledFor DateTime
  status       MedicationLogStatus
  recordedAt   DateTime            @default(now())

  @@unique([medicationId, scheduledFor])
  @@index([userId, scheduledFor])
}

enum VitalType {
  WEIGHT
  BLOOD_PRESSURE
  RESTING_HR
}

model VitalMeasurement {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VitalType
  value     String
  date      DateTime
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// ---------------------------------------------------------------------------
// Reports, notifications, messages, learn content
// ---------------------------------------------------------------------------

model Report {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  rangeLabel   String
  generatedOn  DateTime @default(now())
  dataSnapshot Json
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  detail    String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model Message {
  id            String    @id @default(cuid())
  recipientId   String
  recipient     User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  senderLabel   String
  preview       String
  body          String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([recipientId, readAt])
}

model LearnArticle {
  id          String    @id @default(cuid())
  title       String
  category    String
  readMins    Int
  dek         String
  body        String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Wellness coach & administration
// ---------------------------------------------------------------------------

model CoachAssignment {
  id        String   @id @default(cuid())
  womanId   String
  woman     User     @relation("WomanAssignments", fields: [womanId], references: [id], onDelete: Cascade)
  coachId   String
  coach     User     @relation("CoachAssignments", fields: [coachId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([womanId, coachId])
}

model CoachNote {
  id             String   @id @default(cuid())
  coachId        String
  coach          User     @relation("CoachNoteAuthor", fields: [coachId], references: [id], onDelete: Cascade)
  womanId        String
  woman          User     @relation("CoachNoteSubject", fields: [womanId], references: [id], onDelete: Cascade)
  note           String
  visibleToWoman Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([womanId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  Role?
  action     String
  targetType String?
  targetId   String?
  // Never store request/response bodies or health record contents here —
  // only structural metadata (ids, counts, field names changed).
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
}
