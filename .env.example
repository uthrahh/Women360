# Base URL of the Women360 API (see server/README.md). Includes the /api/v1
# prefix so service calls can use clean relative paths like "/cycle/summary".
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Google Analytics 4 Measurement ID ("G-XXXXXXXXXX"). Leave unset and analytics is completely off: no banner, no script, no request.
# When set, it runs only on the public pages, only after the visitor accepts. See /analytics-reference and docs/ANALYTICS.md.
# VITE_GA_MEASUREMENT_ID=
