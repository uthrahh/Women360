# Used only for the Capacitor mobile build (npm run build:mobile), never
# for the Vercel web build — kept as its own Vite mode file (.env.capacitor)
# specifically so it's never picked up by a plain `vite build` (mode
# "production"), which is what Vercel runs. These values are already public
# (baked into a distributed app bundle either way), so it's fine to commit.
VITE_API_BASE_URL=https://women360-api.onrender.com/api/v1

# Testing-phase only: skips the login/signup screen entirely and gives each
# device its own throwaway account, created automatically on first open.
# Do not enable this for the real web deployment.
VITE_DEVICE_ONLY_MODE=true
